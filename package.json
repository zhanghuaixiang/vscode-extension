{
	"name": "rapid-tools",
	"publisher": "zhanghuaixiang",
	"displayName": "rapid-tools",
	"description": "ics-vscode 插件",
	"version": "0.0.4",
	"icon": "images/icon.png",
	"repository": "https://github.com/zhanghuaixiang/vscode-extension.git",
	"engines": {
		"vscode": "^1.44.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:startup",
		"onCommand:shutdown.task",
		"*"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"menus": {
			"explorer/context": [
				{
					"command": "startup",
					"group": "navigation",
					"when": "condition.showRapidMenu"
				},
				{
					"command": "shutdown.task"
				}
			],
			"editor/context": [
				{
					"command": "opencc.tw2cn",
					"title": "繁体转简体",
					"group": "navigation@0"
				},
				{
					"command": "opencc.cn2tw",
					"title": "简体转繁体",
					"group": "navigation@0"
				},
				{
					"command": "opencc.cn2en",
					"title": "简体转EN",
					"group": "navigation@0",
					"when": "condition.showEnConverter"
				}
			]
		},
		"commands": [
			{
				"command": "shutdown.task",
				"title": "终止终端进程"
			},
			{
				"command": "startup",
				"title": "启动"
			},
			{
				"command": "opencc.tw2cn",
				"title": "[ICS] 繁体 => 简体"
			},
			{
				"command": "opencc.cn2tw",
				"title": "[ICS] 简体 => 繁体"
			},
			{
				"command": "opencc.cn2en",
				"title": "[ICS] 简体 => EN"
			}
		],
		"configuration": {
			"type": "object",
			"title": "文本转换工具",
			"properties": {
				"Converter.ctType": {
					"type": "string",
					"default": "tw",
					"enum": [
						"hk",
						"tw",
						"traditional"
					],
					"description": "繁体类型"
				},
				"Converter.enUrl": {
					"type": "string",
					"default": "http://10.49.38.178:8888/v1/chat/completions",
					"description": "大模型API接口"
				},
				"Converter.enLabel": {
					"type": "string",
					"default": "你现在的角色是一个翻译，接下来我会向你发送一些中文，请将我接下来发给你的中文直接翻译成英文。",
					"description": "大模型API前置对话"
				},
				"Converter.AIModel": {
					"type": "string",
					"default": "yunzhongzi",
					"description": "大模型API模型"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "yarn run package",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"vsce": "vsce package"
	},
	"devDependencies": {
		"@types/glob": "^7.2.0",
		"@types/mocha": "^9.1.0",
		"@types/node": "14.x",
		"@types/vscode": "^1.44.0",
		"@types/webpack-env": "^1.17.0",
		"@typescript-eslint/eslint-plugin": "^5.12.1",
		"@typescript-eslint/parser": "^5.12.1",
		"@vscode/test-electron": "^2.1.2",
		"eslint": "^8.9.0",
		"glob": "^7.2.0",
		"mocha": "^9.2.1",
		"ts-loader": "^9.2.6",
		"typescript": "^4.5.5",
		"webpack": "^5.69.1",
		"webpack-cli": "^4.9.2"
	},
	"dependencies": {
		"axios": "^1.7.2",
		"opencc-js": "^1.0.5"
	}
}