{
	"name": "rapid-tools",
	"publisher": "zhanghuaixiang",
	"displayName": "rapid-tools",
	"description": "ics-vscode 插件",
	"version": "0.0.4",
	"icon": "images/icon.png",
	"repository": "https://github.com/zhanghuaixiang/vscode-extension.git",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "rapidToolsCodeNav",
					"title": "代码理解",
					"icon": "images/code-nav.svg"
				}
			]
		},
		"views": {
			"rapidToolsCodeNav": [
				{
					"id": "rapidTools.codeNav",
					"name": "单文件导读",
					"type": "webview"
				}
			]
		},
		"menus": {
			"explorer/context": [
				{
					"command": "startup",
					"group": "navigation",
					"when": "condition.showRapidMenu"
				}
			],
			"editor/context": [
				{
					"command": "opencc.tw2cn",
					"title": "繁体转简体",
					"group": "navigation@0",
					"when": "condition.showCn2Tw"
				},
				{
					"command": "opencc.cn2tw",
					"title": "简体转繁体",
					"group": "navigation@0",
					"when": "condition.showCn2Tw"
				},
				{
					"command": "opencc.cn2en",
					"title": "简体转EN",
					"group": "navigation@0",
					"when": "condition.showEnConverter"
				},
				{
					"command": "rapidTools.codeNav.refresh",
					"group": "navigation@1",
					"when": "resourceExtname == .vue || resourceExtname == .js"
				}
			]
		},
		"commands": [
			{
				"command": "startup",
				"title": "启动"
			},
			{
				"command": "opencc.tw2cn",
				"title": "[ICS] 繁体 => 简体",
				"enablement": "condition.showCn2Tw"
			},
			{
				"command": "opencc.cn2tw",
				"title": "[ICS] 简体 => 繁体",
				"enablement": "condition.showCn2Tw"
			},
			{
				"command": "opencc.cn2en",
				"title": "[ICS] 简体 => EN"
			},
			{
				"command": "rapidTools.codeNav.refresh",
				"title": "刷新代码导航"
			}
		],
		"configuration": {
			"type": "object",
			"title": "rapid-tools",
			"properties": {
				"AI.baseUrl": {
					"type": "string",
					"default": "",
					"description": "大模型接口地址（OpenAI 兼容，如 https://host/v1/chat/completions）"
				},
				"AI.model": {
					"type": "string",
					"default": "yunzhongzi",
					"description": "大模型名称，简繁英转换与代码理解 AI 解读共用"
				},
				"AI.apiKey": {
					"type": "string",
					"default": "",
					"description": "大模型接口密钥，按 Authorization: Bearer 发送；内网网关无需鉴权时留空"
				},
				"AI.enable": {
					"type": "boolean",
					"default": false,
					"description": "代码理解面板的 AI 解读开关（默认关闭；关闭时不发起任何请求）"
				},
				"Converter.ctEnable": {
					"type": "boolean",
					"default": false,
					"description": "是否启用简繁体转换功能（默认关闭）"
				},
				"Converter.ctType": {
					"type": "string",
					"default": "tw",
					"enum": [
						"hk",
						"tw",
						"traditional"
					],
					"description": "繁体类型"
				},
				"Converter.enLabel": {
					"type": "string",
					"default": "你现在的角色是一个翻译，接下来我会向你发送一些中文，请将我接下来发给你的中文直接翻译成英文。",
					"description": "简转EN 的提示词（大模型API前置对话）"
				},
				"I18n.enable": {
					"type": "boolean",
					"default": false,
					"description": "是否启用国际化悬浮提示功能（默认关闭）"
				},
				"I18n.langs": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"cn",
							"en",
							"tw"
						]
					},
					"default": [
						"cn",
						"en"
					],
					"description": "启用的国际化语言标识，语言目录为 基础路径/标识；第一个语言作为悬停提示的基准语言"
				},
				"I18n.basePath": {
					"type": "string",
					"default": "src/i18n",
					"description": "国际化文件基础目录（相对工作区根目录）"
				},
				"I18n.validPath": {
					"type": "string",
					"default": "**/src/**",
					"description": "启用国际化悬停提示的文件 glob 模式，留空则不启用悬停提示"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "yarn run package",
		"compile": "webpack",
		"code-nav:analyze": "node dist/codeNavCli.js",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"vsce": "vsce package"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.43",
		"@types/opencc-js": "^1.0.3",
		"@types/vscode": "^1.100.0",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vscode/test-electron": "^2.5.2",
		"@vue/compiler-core": "^3.5.0",
		"eslint": "^8.57.1",
		"glob": "^11.1.0",
		"mocha": "^11.8.0",
		"ts-loader": "^9.6.2",
		"typescript": "^5.9.3",
		"webpack": "^5.112.0",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@babel/parser": "^7.28.0",
		"@babel/types": "^7.28.0",
		"@vue/compiler-sfc": "^3.5.0",
		"opencc-js": "^1.0.5"
	}
}